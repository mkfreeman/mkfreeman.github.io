---
// A small recreation of the sortable/searchable table component
// built for Observable Framework — driven by this site's own project data.
const rows = [
  { project: "Data Table", category: "Software", type: "Component" },
  { project: "Duckplot", category: "Software", type: "Library" },
  { project: "Financing Global Health", category: "Data Viz", type: "Dashboard" },
  { project: "Hierarchical Modeling", category: "Teaching", type: "Explainer" },
  { project: "Central Limit Theorem", category: "Teaching", type: "Explainer" },
  { project: "Prediction Metrics", category: "Teaching", type: "Explainer" },
  { project: "Triangulate", category: "Data Art", type: "Tool" },
  { project: "Summary Table", category: "Data Viz", type: "Notebook" },
  { project: "Plot Cheatsheets", category: "Data Viz", type: "Documentation" },
  { project: "Tobacco Use", category: "Data Viz", type: "Dashboard" },
];
---

<div
  class="data-table-demo overflow-hidden rounded-xl border border-black/10 bg-white"
  data-rows={JSON.stringify(rows)}
>
  <div class="flex items-center gap-2 border-b border-black/10 p-3">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#898781]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
    </svg>
    <input
      type="text"
      placeholder="Filter by project or category…"
      class="dt-search w-full bg-transparent text-sm text-[#0b0b0b] placeholder:text-[#898781] focus:outline-none"
    />
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-black/10 text-[#52514e]">
          <th class="dt-sort cursor-pointer select-none px-4 py-2 font-medium hover:text-[#0b0b0b]" data-key="project">Project ↕</th>
          <th class="dt-sort cursor-pointer select-none px-4 py-2 font-medium hover:text-[#0b0b0b]" data-key="category">Category ↕</th>
          <th class="dt-sort cursor-pointer select-none px-4 py-2 font-medium hover:text-[#0b0b0b]" data-key="type">Type ↕</th>
        </tr>
      </thead>
      <tbody class="dt-body"></tbody>
    </table>
  </div>
  <p class="dt-empty hidden px-4 py-6 text-center text-sm text-[#898781]">No rows match your filter.</p>
</div>

<script>
  type Row = { project: string; category: string; type: string };

  document.querySelectorAll<HTMLElement>(".data-table-demo").forEach((root) => {
    const rows: Row[] = JSON.parse(root.dataset.rows || "[]");
    const body = root.querySelector<HTMLElement>(".dt-body")!;
    const empty = root.querySelector<HTMLElement>(".dt-empty")!;
    const search = root.querySelector<HTMLInputElement>(".dt-search")!;
    const headers = root.querySelectorAll<HTMLElement>(".dt-sort");

    let sortKey: keyof Row = "project";
    let sortDir: 1 | -1 = 1;
    let query = "";

    function render() {
      const filtered = rows.filter((r) =>
        `${r.project} ${r.category} ${r.type}`.toLowerCase().includes(query)
      );
      filtered.sort((a, b) => sortDir * a[sortKey].localeCompare(b[sortKey]));

      body.innerHTML = filtered
        .map(
          (r) => `
        <tr class="border-b border-black/5 last:border-0 hover:bg-[#f9f9f7]">
          <td class="px-4 py-2 text-[#0b0b0b]">${r.project}</td>
          <td class="px-4 py-2 text-[#52514e]">${r.category}</td>
          <td class="px-4 py-2 text-[#52514e]">${r.type}</td>
        </tr>`
        )
        .join("");

      empty.classList.toggle("hidden", filtered.length > 0);
    }

    search.addEventListener("input", () => {
      query = search.value.trim().toLowerCase();
      render();
    });

    headers.forEach((th) => {
      th.addEventListener("click", () => {
        const key = th.dataset.key as keyof Row;
        sortDir = sortKey === key ? ((sortDir * -1) as 1 | -1) : 1;
        sortKey = key;
        render();
      });
    });

    render();
  });
</script>
