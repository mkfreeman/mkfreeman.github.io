---
interface Props {
  item: {
    title: string;
    org: string;
    period: string;
    description: string;
    url: string;
    linkLabel: string;
    img: string;
    alt: string;
    repo?: string;
} 
}
const { item } = Astro.props;
---

<div class="flex h-full flex-col gap-4">
              <div>
                <h3 class="text-lg font-semibold text-[#0b0b0b]">{item.title}</h3>
                <p class="text-sm text-[#898781]">{item.org}</p>
                <p class="mt-2 text-sm text-[#52514e]">{item.description}</p>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block text-sm font-medium text-[#be185d] hover:underline"
                >
                  {item.linkLabel} →
                </a>
              </div>
              <div class="aspect-video overflow-hidden rounded-xl border border-black/20 bg-white">
                <img src={item.img} alt={item.alt} class="h-full w-full object-cover" />
              </div>
            </div>