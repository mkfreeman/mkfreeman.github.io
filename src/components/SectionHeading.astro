---
interface Props {
  eyebrow: string;
  title: string;
  blurb: string;
}
const { eyebrow, title, blurb } = Astro.props;
---

<div class="max-w-2xl">
  <p class="text-sm font-medium uppercase tracking-widest text-[#2a78d6]">{eyebrow}</p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#0b0b0b] sm:text-4xl">{title}</h2>
  <p class="mt-4 text-base text-[#52514e] sm:text-lg">{blurb}</p>
</div>
