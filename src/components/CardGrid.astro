---
interface Item {
  title: string;
  description: string;
  url?: string;
  img?: string;
  alt?: string;
  comingSoon?: boolean;
  logo?: boolean;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) =>
      item.comingSoon ? (
        <div class="flex flex-col overflow-hidden rounded-xl border border-dashed border-black/25 bg-transparent">
          <div class="flex aspect-video w-full items-center justify-center bg-[#f0efec]/60">
            <span class="text-sm font-medium uppercase tracking-widest text-[#898781]">Coming soon</span>
          </div>
          <div class="flex flex-1 flex-col gap-1.5 p-4">
            <h3 class="font-medium text-[#0b0b0b]">{item.title}</h3>
            <p class="text-sm text-[#52514e]">{item.description}</p>
          </div>
        </div>
      ) : (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col overflow-hidden rounded-xl border border-black/20 bg-white transition-shadow hover:shadow-md"
        >
          {item.img && (
            <div class={`aspect-video w-full overflow-hidden bg-[#f0efec] ${item.logo ? "flex items-center justify-center p-3" : ""}`}>
              <img
                src={item.img}
                alt={item.alt || item.title}
                loading="lazy"
                class={
                  item.logo
                    ? "h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
                    : "h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
                }
              />
            </div>
          )}
          <div class="flex flex-1 flex-col gap-1.5 p-4">
            <h3 class="font-medium text-[#0b0b0b]">{item.title}</h3>
            <p class="text-sm text-[#52514e]">{item.description}</p>
          </div>
        </a>
      )
    )
  }
</div>
