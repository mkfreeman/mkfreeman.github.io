---
---

<div class="triangulate-demo rounded-xl border border-black/10 bg-white p-4 sm:p-5">
  <div class="mb-3 flex items-center justify-between gap-3">
    <p class="text-sm font-medium text-[#0b0b0b]">Low-poly render, generated in your browser</p>
    <button
      type="button"
      class="tri-reroll rounded-full border border-black/15 px-3 py-1.5 text-xs font-medium text-[#0b0b0b] transition-colors hover:bg-black/5"
    >
      Re-roll ↻
    </button>
  </div>
  <canvas class="tri-canvas w-full rounded-lg bg-[#f0efec]" width="400" height="300"></canvas>
  <p class="mt-3 text-xs text-[#898781]">
    A tiny version of
    <a href="http://mfviz.com/triangulate" target="_blank" rel="noopener noreferrer" class="text-[#2a78d6] hover:underline"
      >Triangulate</a
    >, a tool I built for turning photos into geometric art — sample any triangle's color and you get a
    facet of a low-poly rendering.
  </p>
</div>

<script>
  import { Delaunay } from "d3-delaunay";

  document.querySelectorAll<HTMLElement>(".triangulate-demo").forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>(".tri-canvas")!;
    const button = root.querySelector<HTMLButtonElement>(".tri-reroll")!;
    const ctx = canvas.getContext("2d")!;
    const off = document.createElement("canvas");
    off.width = canvas.width;
    off.height = canvas.height;
    const offCtx = off.getContext("2d")!;

    const img = new Image();
    img.src = "/imgs/freeman_photo.png";

    function points(w: number, h: number, n: number) {
      const pts: [number, number][] = [
        [0, 0],
        [w, 0],
        [0, h],
        [w, h],
        [w / 2, 0],
        [w / 2, h],
        [0, h / 2],
        [w, h / 2],
      ];
      for (let i = 0; i < n; i++) pts.push([Math.random() * w, Math.random() * h]);
      return pts;
    }

    function draw() {
      const w = canvas.width;
      const h = canvas.height;

      const scale = Math.max(w / img.width, h / img.height);
      const iw = img.width * scale;
      const ih = img.height * scale;
      offCtx.clearRect(0, 0, w, h);
      offCtx.drawImage(img, (w - iw) / 2, (h - ih) / 2, iw, ih);

      const pts = points(w, h, 90);
      const delaunay = Delaunay.from(pts);

      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < delaunay.triangles.length; i += 3) {
        const p0 = pts[delaunay.triangles[i]];
        const p1 = pts[delaunay.triangles[i + 1]];
        const p2 = pts[delaunay.triangles[i + 2]];
        const cx = (p0[0] + p1[0] + p2[0]) / 3;
        const cy = (p0[1] + p1[1] + p2[1]) / 3;
        const [r, g, b] = offCtx.getImageData(Math.min(w - 1, cx), Math.min(h - 1, cy), 1, 1).data;

        ctx.beginPath();
        ctx.moveTo(p0[0], p0[1]);
        ctx.lineTo(p1[0], p1[1]);
        ctx.lineTo(p2[0], p2[1]);
        ctx.closePath();
        ctx.fillStyle = `rgb(${r},${g},${b})`;
        ctx.fill();
      }
    }

    img.addEventListener("load", draw);
    button.addEventListener("click", draw);
  });
</script>
