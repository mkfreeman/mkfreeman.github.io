---
const sourceColors: Record<string, string> = {
  Governments: "#2a78d6",
  Foundations: "#eb6834",
  Private: "#1baf7a",
};

const links = [
  { source: "Governments", target: "HIV / AIDS", value: 40 },
  { source: "Governments", target: "Maternal & Child Health", value: 30 },
  { source: "Governments", target: "Other Health Focus Areas", value: 20 },
  { source: "Foundations", target: "HIV / AIDS", value: 15 },
  { source: "Foundations", target: "Maternal & Child Health", value: 10 },
  { source: "Foundations", target: "Other Health Focus Areas", value: 5 },
  { source: "Private", target: "HIV / AIDS", value: 5 },
  { source: "Private", target: "Maternal & Child Health", value: 8 },
  { source: "Private", target: "Other Health Focus Areas", value: 7 },
];
---

<div
  class="sankey-demo rounded-xl border border-black/10 bg-white p-4 sm:p-5"
  data-links={JSON.stringify(links)}
  data-colors={JSON.stringify(sourceColors)}
>
  <p class="mb-3 text-sm font-medium text-[#0b0b0b]">Illustrative flow of global health funding</p>
  <svg class="sk-chart w-full" viewBox="0 0 400 220" role="img" aria-label="Sankey diagram of illustrative global health funding flows"></svg>
  <p class="mt-3 text-xs text-[#898781]">
    Simplified, illustrative figures. The real thing — tracking billions of dollars across sources, channels,
    and health focus areas — is
    <a href="http://vizhub.healthdata.org/fgh/" target="_blank" rel="noopener noreferrer" class="text-[#2a78d6] hover:underline"
      >Financing Global Health</a
    >, built for IHME.
  </p>
</div>

<script>
  import { select } from "d3-selection";
  import { sankey, sankeyLinkHorizontal } from "d3-sankey";

  type Link = { source: string; target: string; value: number };

  document.querySelectorAll<HTMLElement>(".sankey-demo").forEach((root) => {
    const links: Link[] = JSON.parse(root.dataset.links || "[]");
    const colors: Record<string, string> = JSON.parse(root.dataset.colors || "{}");
    const svg = select(root.querySelector<SVGSVGElement>(".sk-chart")!);

    const width = 400;
    const height = 220;

    const names = Array.from(new Set(links.flatMap((l) => [l.source, l.target])));
    const nodes = names.map((name) => ({ name }));
    const index = new Map(names.map((name, i) => [name, i]));

    const graph = {
      nodes,
      links: links.map((l) => ({ source: index.get(l.source)!, target: index.get(l.target)!, value: l.value, sourceName: l.source })),
    };

    const { nodes: laidOutNodes, links: laidOutLinks } = sankey<any, any>()
      .nodeWidth(12)
      .nodePadding(10)
      .extent([
        [1, 5],
        [width - 1, height - 5],
      ])(graph as any);

    svg.attr("viewBox", `0 0 ${width} ${height}`);
    svg.selectAll("*").remove();

    svg
      .selectAll(".link")
      .data(laidOutLinks)
      .join("path")
      .attr("class", "link")
      .attr("d", sankeyLinkHorizontal())
      .attr("fill", "none")
      .attr("stroke", (d: any) => colors[d.sourceName] ?? "#c3c2b7")
      .attr("stroke-opacity", 0.35)
      .attr("stroke-width", (d: any) => Math.max(1, d.width))
      .append("title")
      .text((d: any) => `${d.sourceName} → ${d.target.name}: ${d.value}`);

    svg
      .selectAll(".node")
      .data(laidOutNodes)
      .join("rect")
      .attr("class", "node")
      .attr("x", (d: any) => d.x0)
      .attr("y", (d: any) => d.y0)
      .attr("width", (d: any) => d.x1 - d.x0)
      .attr("height", (d: any) => Math.max(1, d.y1 - d.y0))
      .attr("fill", (d: any) => colors[d.name] ?? "#52514e")
      .attr("rx", 2);

    svg
      .selectAll(".label")
      .data(laidOutNodes)
      .join("text")
      .attr("class", "label")
      .attr("x", (d: any) => (d.x0 < width / 2 ? d.x1 + 5 : d.x0 - 5))
      .attr("y", (d: any) => (d.y0 + d.y1) / 2)
      .attr("dy", "0.32em")
      .attr("text-anchor", (d: any) => (d.x0 < width / 2 ? "start" : "end"))
      .attr("font-size", 8.5)
      .attr("fill", "#52514e")
      .text((d: any) => d.name);
  });
</script>
