---
const links = [
  { href: "#software", label: "Software" },
  { href: "#dataviz", label: "Data Visualization", shortLabel: "Visualization" },
  { href: "#visual-explanations", label: "Visual Explanations", shortLabel: "Explanations" },
  { href: "#teaching", label: "Teaching" },
  { href: "#art", label: "Art" },
];
---

<header class="sticky top-0 z-50 border-b border-black/20 bg-[#f9f9f7]/90 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3 sm:px-8">
    <a href="#top" class="text-sm font-semibold tracking-tight text-[#be185d]">Michael Freeman</a>

    <ul class="hidden gap-8 text-sm text-[#52514e] sm:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} data-nav-link class="transition-colors hover:text-[#0b0b0b]">
              <span class="hidden min-[700px]:inline-block" data-bold-text={link.label}>{link.label}</span>
              <span class="inline-block min-[700px]:hidden" data-bold-text={link.shortLabel ?? link.label}>
                {link.shortLabel ?? link.label}
              </span>
            </a>
          </li>
        ))
      }     
    </ul>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      class="flex h-9 w-9 items-center justify-center rounded-md sm:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <ul id="nav-menu" hidden class="flex flex-col gap-1 border-t border-black/20 px-5 pb-4 text-sm sm:hidden">
    {
      links.map((link) => (
        <li>
          <a href={link.href} data-nav-link class="block rounded-md px-2 py-2.5 text-[#0b0b0b] hover:bg-black/5">
            {link.label}
          </a>
        </li>
      ))
    }
   
  </ul>
</header>

<style>
  a[data-nav-link][data-active] {
    color: #be185d;
    font-weight: 500;
  }

  /* Reserve width for the bold state so links don't shift as the active
     section changes while scrolling — each label's box is pre-sized to its
     own bold rendering via an invisible ::after copy. */
  [data-bold-text] {
    position: relative;
  }
  [data-bold-text]::after {
    content: attr(data-bold-text);
    display: block;
    height: 0;
    visibility: hidden;
    overflow: hidden;
    font-weight: 500;
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    menu?.toggleAttribute("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    })
  );

  // Scroll spy: highlight the nav link for the section currently in view.
  // Sections here are much taller than the viewport, so IntersectionObserver's
  // enter/exit events are unreliable — instead, on each scroll, pick the last
  // section whose top has passed the header.
  const header = document.querySelector<HTMLElement>("header");
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]"));
  const sections = navLinks
    .map((link) => document.getElementById(link.getAttribute("href")?.slice(1) ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  function setActive(id: string | null) {
    navLinks.forEach((link) => {
      link.toggleAttribute("data-active", id !== null && link.getAttribute("href") === `#${id}`);
    });
  }

  function updateActiveSection() {
    // Near the bottom of the page there may not be enough scroll room left for
    // the last section's top to ever clear the header offset — force it active.
    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atBottom) {
      setActive(sections[sections.length - 1]?.id ?? null);
      return;
    }

    const offset = (header?.offsetHeight ?? 0) + 8;
    const scrollPos = window.scrollY + offset;

    let currentId: string | null = null;
    for (const section of sections) {
      if (section.offsetTop <= scrollPos) {
        currentId = section.id;
      }
    }
    setActive(currentId);
  }

  if (sections.length) {
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateActiveSection();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    updateActiveSection();
  }
</script>
