---
const links = [
  { href: "#software", label: "Software" },
  { href: "#dataviz", label: "Data Viz" },
  { href: "#teaching", label: "Teaching" },
  { href: "#about", label: "About" },
];
---

<header class="sticky top-0 z-50 border-b border-black/10 bg-[#f9f9f7]/90 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3 sm:px-8">
    <a href="#top" class="text-sm font-semibold tracking-tight">Michael Freeman</a>

    <ul class="hidden gap-8 text-sm text-[#52514e] sm:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-[#0b0b0b]">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/freeman-cv.pdf"
          class="transition-colors hover:text-[#0b0b0b]"
          target="_blank"
          rel="noopener noreferrer">CV</a
        >
      </li>
    </ul>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      class="flex h-9 w-9 items-center justify-center rounded-md sm:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <ul id="nav-menu" hidden class="flex flex-col gap-1 border-t border-black/10 px-5 pb-4 text-sm sm:hidden">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="block rounded-md px-2 py-2.5 text-[#0b0b0b] hover:bg-black/5">
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        href="/freeman-cv.pdf"
        class="block rounded-md px-2 py-2.5 text-[#0b0b0b] hover:bg-black/5"
        target="_blank"
        rel="noopener noreferrer">CV</a
      >
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    menu?.toggleAttribute("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    })
  );
</script>
