---
const groups = [
  { name: "Hospital A", color: "#2a78d6", estimates: [8, 5, 3, 6] },
  { name: "Hospital B", color: "#eb6834", estimates: [6, 9, 4] },
  { name: "Hospital C", color: "#1baf7a", estimates: [4, 4, 7, 2, 5] },
];
---

<div class="hierarchy-demo rounded-xl border border-black/10 bg-white p-4 sm:p-5" data-groups={JSON.stringify(groups)}>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm font-medium text-[#0b0b0b]">Patient estimates, grouped by hospital</p>
    <ul class="flex gap-3 text-xs text-[#52514e]">
      {
        groups.map((g) => (
          <li class="flex items-center gap-1.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background:${g.color}`} />
            {g.name}
          </li>
        ))
      }
    </ul>
  </div>

  <svg class="h-demo-chart w-full" viewBox="0 0 400 260" role="img" aria-label="Circle-packed diagram of hospitals and patient estimates"></svg>

  <p class="mt-3 text-xs text-[#898781]">
    Each hospital reports a handful of noisy estimates. A hierarchical model treats each hospital as its own
    group while still learning from the others — small hospitals borrow strength from the full dataset.
  </p>
</div>

<script>
  import { select } from "d3-selection";
  import { hierarchy, pack } from "d3-hierarchy";

  type Group = { name: string; color: string; estimates: number[] };

  document.querySelectorAll<HTMLElement>(".hierarchy-demo").forEach((root) => {
    const groups: Group[] = JSON.parse(root.dataset.groups || "[]");
    const svg = select(root.querySelector<SVGSVGElement>(".h-demo-chart")!);

    const width = 400;
    const height = 260;

    const rootData = {
      name: "All studies",
      children: groups.map((g) => ({
        name: g.name,
        color: g.color,
        children: g.estimates.map((v, i) => ({ name: `${g.name} #${i + 1}`, value: v, color: g.color })),
      })),
    };

    const rootNode = hierarchy(rootData)
      .sum((d: any) => d.value ?? 0)
      .sort((a, b) => (b.value ?? 0) - (a.value ?? 0));

    pack<typeof rootData>().size([width, height]).padding(3)(rootNode as any);

    svg.attr("viewBox", `0 0 ${width} ${height}`);
    svg.selectAll("*").remove();

    // group + root circles (outline only)
    svg
      .selectAll(".shell")
      .data(rootNode.descendants().filter((d) => d.depth < 2))
      .join("circle")
      .attr("class", "shell")
      .attr("cx", (d: any) => d.x)
      .attr("cy", (d: any) => d.y)
      .attr("r", (d: any) => d.r)
      .attr("fill", "none")
      .attr("stroke", (d: any) => (d.depth === 1 ? d.data.color : "#c3c2b7"))
      .attr("stroke-width", (d: any) => (d.depth === 1 ? 1.5 : 1))
      .attr("stroke-dasharray", (d: any) => (d.depth === 0 ? "3,3" : null))
      .attr("opacity", (d: any) => (d.depth === 1 ? 0.6 : 0.4));

    const leaves = svg
      .selectAll(".leaf")
      .data(rootNode.leaves())
      .join("circle")
      .attr("class", "leaf")
      .attr("cx", (d: any) => d.x)
      .attr("cy", (d: any) => d.y)
      .attr("r", (d: any) => d.r)
      .attr("fill", (d: any) => d.data.color)
      .attr("fill-opacity", 0.85)
      .attr("stroke", "#fcfcfb")
      .attr("stroke-width", 1.5);

    leaves.append("title").text((d: any) => `${d.data.name}: ${d.data.value}`);
  });
</script>
